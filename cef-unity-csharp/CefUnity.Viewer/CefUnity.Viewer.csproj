<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RustProjectDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\cef-unity-rust'))</RustProjectDir>
    <RustTargetDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\cef-unity-rust\target\debug'))</RustTargetDir>
  </PropertyGroup>
  <!-- 表示内容を自動検証するため、描画結果を PNG に書き出す (CEFUNITY_CAPTURE、Linux)。
       Harness の PNG ライターを共有する。ProjectReference にすると Harness の
       CopyServerApp が走るためリンク参照にする (CefUnity.Tests と同じ方式)。 -->
  <ItemGroup>
    <Compile Include="..\CefUnity.Harness\PortableNetworkGraphicsWriter.cs"
             Link="PortableNetworkGraphicsWriter.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CefUnity.Core\CefUnity.Core.csproj" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Windowing.Sdl" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Input.Sdl" Version="2.22.0" />
    <PackageReference Include="Silk.NET.SDL" Version="2.22.0" />
    <!-- Linux の表示経路 (OpenGLFrameRenderer)。SDL は GLES 要求時に EGL コンテキストを作る。 -->
    <PackageReference Include="Silk.NET.OpenGLES" Version="2.22.0" />
    <!-- Windows の表示経路 (D3D11FrameRenderer)。非 Windows でもビルドは通る (P/Invoke は実行時解決)。 -->
    <PackageReference Include="Silk.NET.Direct3D11" Version="2.22.0" />
    <PackageReference Include="Silk.NET.DXGI" Version="2.22.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- debug 成果物はローカル開発専用。CI は release ビルドのみで target/debug が無いため Exists ガード必須
         (Tests が Viewer を参照するので、ガードが無いと CI の dotnet test が MSB3030 で落ちる) -->
    <None Include="$(RustTargetDir)/libcef_unity_rust.dylib"
          CopyToOutputDirectory="PreserveNewest" Link="libcef_unity_rust.dylib"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) And Exists('$(RustTargetDir)/libcef_unity_rust.dylib')" />
    <!-- Linux: Rust 成果物は Rust の再ビルドに追従させるため PreserveNewest で毎回見る。
         CEF ランタイム (巨大で変わらない) は下の CopyLinuxRuntime が初回だけ配置する。 -->
    <None Include="$(RustTargetDir)/libcef_unity_rust.so"
          CopyToOutputDirectory="PreserveNewest" Link="libcef_unity_rust.so"
          Condition="$([MSBuild]::IsOSPlatform('Linux')) And Exists('$(RustTargetDir)/libcef_unity_rust.so')" />
    <None Include="$(RustTargetDir)/cef-unity-server"
          CopyToOutputDirectory="PreserveNewest" Link="cef-unity-server"
          Condition="$([MSBuild]::IsOSPlatform('Linux')) And Exists('$(RustTargetDir)/cef-unity-server')" />
    <None Include="$(RustTargetDir)/cef-unity-rust-helper"
          CopyToOutputDirectory="PreserveNewest" Link="cef-unity-rust-helper"
          Condition="$([MSBuild]::IsOSPlatform('Linux')) And Exists('$(RustTargetDir)/cef-unity-rust-helper')" />
  </ItemGroup>
  <!-- cef-unity-server.app を出力先に用意 (Harness と同じ)。既存ならスキップ (dotnet test を遅くしない) -->
  <Target Name="CopyServerApp" AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) And !Exists('$(OutputPath)cef-unity-server.app') And Exists('$(RustTargetDir)/cef-unity-server')">
    <Exec Command="bash '$(RustProjectDir)/build-server-sandbox.sh' '$(OutputPath)'" />
  </Target>
  <!-- Linux: server は libcef_unity_rust.so と同じディレクトリ直下から起動されるため、
       CEF ランタイムを出力先へフラット配置する (Harness と同じ build-server-sandbox.sh)。
       libcef.so は 1 GB を超えるので、既に配置済みならスキップする (dotnet test を遅くしない)。 -->
  <Target Name="CopyLinuxRuntime" AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Linux')) And !Exists('$(OutputPath)libcef.so') And Exists('$(RustTargetDir)/cef-unity-server')">
    <Exec Command="bash '$(RustProjectDir)/build-server-sandbox.sh' '$(OutputPath)'" />
  </Target>
  <!-- Windows: cef-unity-server.exe は cef_unity_rust.dll と同じディレクトリ直下から
       起動されるため、Rust 成果物と CEF ランタイムを出力先へフラット配置する
       (deploy.ps1 と同じスクリプトを共有)。Rust 未ビルド環境ではスクリプト側が警告のみで抜ける。
       注: 配置元は release ビルド。RustTargetDir (debug) ではない。 -->
  <Target Name="CopyWindowsRuntime" AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <!-- OutputPath は末尾が \ なので、引用符の直前に来ると PowerShell 側で
         エスケープと解釈される。TrimEnd で落としてから渡す。 -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(RustProjectDir)\copy-windows-runtime.ps1&quot; -Destination &quot;$(OutputPath.TrimEnd('\'))&quot;" />
  </Target>
</Project>
